rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isTeacher(roomId) {
      return signedIn() && room(roomId).teacherSessionId == request.auth.uid;
    }

    function isPlayerOwner(roomId, playerId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)).data.ownerUid == request.auth.uid;
    }

    function isPlayerOwnerAfter(roomId, playerId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)).data.ownerUid == request.auth.uid;
    }

    // Exactly 10 integer responses, each 1-5 — the PRE assessment's only
    // accepted shape. Written out per-index rather than a loop: Firestore
    // rules have no iteration construct, and this stays consistent with how
    // every other fixed-shape document in this ruleset is validated.
    function isValidPreResponses(responses) {
      return responses is list
        && responses.size() == 10
        && responses[0] in [1, 2, 3, 4, 5]
        && responses[1] in [1, 2, 3, 4, 5]
        && responses[2] in [1, 2, 3, 4, 5]
        && responses[3] in [1, 2, 3, 4, 5]
        && responses[4] in [1, 2, 3, 4, 5]
        && responses[5] in [1, 2, 3, 4, 5]
        && responses[6] in [1, 2, 3, 4, 5]
        && responses[7] in [1, 2, 3, 4, 5]
        && responses[8] in [1, 2, 3, 4, 5]
        && responses[9] in [1, 2, 3, 4, 5];
    }

    // POST reuses the exact same 10-item, 1-5 shape as PRE (see
    // src/domain/assessment.ts) — same validator, different record type.
    function isValidPostResponses(responses) {
      return isValidPreResponses(responses);
    }

    // Non-empty after trimming (matches src/domain/assessment.ts's
    // isValidReflection, which rules cannot call directly), and bounded —
    // REFLECTION_ANSWER_MAX_LENGTH in that same file. Rules have no
    // .trim(), so "non-empty after trim" is expressed as "contains at
    // least one non-whitespace character".
    function isMeaningfulReflectionText(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 1000
        && value.matches('.*\\S.*');
    }

    // Teacher observation dimensions (O1-O4, Phase B2a) accept integer 1..4.
    function isValidObservationScore(value) {
      return value is int && value in [1, 2, 3, 4];
    }

    // Optional bounded notes for teacher observation — bounded at 1000 chars.
    function isValidObservationNotes(value) {
      return value is string && value.size() <= 1000;
    }

    // CITY LAYOUT ENVIRONMENT BLOCK START
    // STAGING ONLY: every app client already has an anonymous Firebase
    // session. Any signed-in staging user may calibrate layout, while all
    // classroom/player/assessment rules below remain byte-for-byte identical
    // to production.
    function isCityLayoutScene(value) {
      return value in ['degraded', 'normal', 'developed'];
    }

    function isCityLayoutBuilding(value) {
      return value in ['school', 'hospital', 'police', 'construction', 'market', 'municipality', 'newsAgency'];
    }

    function isCityLayoutLevel(value) {
      return value is int && value in [-2, -1, 0, 1, 2];
    }

    function isSaneCityLayoutPlacement(data) {
      return data.x is number && data.x >= -2000 && data.x <= 2000
        && data.y is number && data.y >= -2000 && data.y <= 2000
        && data.scaleX is number && data.scaleX >= 0.05 && data.scaleX <= 10
        && data.scaleY is number && data.scaleY >= 0.05 && data.scaleY <= 10;
    }

    function isCompleteCityLayoutBuilding(levels) {
      return levels is map
        && levels.size() == 5
        && levels.keys().hasOnly(['-2', '-1', '0', '1', '2']);
    }

    function isCompleteCityLayoutScene(scene) {
      return scene is map
        && scene.size() == 7
        && scene.keys().hasOnly(['school', 'hospital', 'police', 'construction', 'market', 'municipality', 'newsAgency'])
        && isCompleteCityLayoutBuilding(scene.school)
        && isCompleteCityLayoutBuilding(scene.hospital)
        && isCompleteCityLayoutBuilding(scene.police)
        && isCompleteCityLayoutBuilding(scene.construction)
        && isCompleteCityLayoutBuilding(scene.market)
        && isCompleteCityLayoutBuilding(scene.municipality)
        && isCompleteCityLayoutBuilding(scene.newsAgency);
    }

    function isCompleteCityLayout(placements) {
      return placements is map
        && placements.size() == 3
        && placements.keys().hasOnly(['degraded', 'normal', 'developed'])
        && isCompleteCityLayoutScene(placements.degraded)
        && isCompleteCityLayoutScene(placements.normal)
        && isCompleteCityLayoutScene(placements.developed);
    }

    match /system/cityLayoutAccess {
      allow read, write: if false;
    }

    match /cityLayoutDraft/{draftId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isCityLayoutScene(request.resource.data.scene)
        && isCityLayoutBuilding(request.resource.data.building)
        && isCityLayoutLevel(request.resource.data.level)
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.keys().hasOnly(['scene', 'building', 'level', 'x', 'y', 'scaleX', 'scaleY', 'updatedAt'])
            && draftId == request.resource.data.scene + '__' + request.resource.data.building + '__' + string(request.resource.data.level)
            && isSaneCityLayoutPlacement(request.resource.data)
          )
          ||
          (
            request.resource.data.keys().hasOnly(['scene', 'building', 'level', 'labelX', 'labelY', 'updatedAt'])
            && draftId == request.resource.data.scene + '__' + request.resource.data.building + '__' + string(request.resource.data.level) + '__label'
            && request.resource.data.labelX is number
            && request.resource.data.labelX >= -2000
            && request.resource.data.labelX <= 2000
            && request.resource.data.labelY is number
            && request.resource.data.labelY >= -2000
            && request.resource.data.labelY <= 2000
          )
        );
      allow delete: if signedIn();
    }

    match /cityLayoutVersions/{versionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'versionId', 'placements', 'publishedAt'])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.versionId == versionId
        && isCompleteCityLayout(request.resource.data.placements)
        && request.resource.data.publishedAt == request.time;
      allow update, delete: if false;
    }

    match /cityLayoutPublished/current {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'versionId', 'placements', 'publishedAt'])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.versionId is string
        && isCompleteCityLayout(request.resource.data.placements)
        && request.resource.data.publishedAt == request.time
        && existsAfter(/databases/$(database)/documents/cityLayoutVersions/$(request.resource.data.versionId))
        && getAfter(/databases/$(database)/documents/cityLayoutVersions/$(request.resource.data.versionId)).data.schemaVersion == request.resource.data.schemaVersion
        && getAfter(/databases/$(database)/documents/cityLayoutVersions/$(request.resource.data.versionId)).data.placements == request.resource.data.placements;
      allow delete: if false;
    }
    // CITY LAYOUT ENVIRONMENT BLOCK END


    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.teacherSessionId == request.auth.uid
        && request.resource.data.roomId == roomId
        && request.resource.data.keys().hasAll([
          'status',
          'gameCycle',
          'completedGameCount',
          'currentQuestionNumber',
          'currentCrisisEventIndex',
          'currentCrisisEventId',
          'questionDurationSec',
          'questionStartedAt',
          'questionDeadlineAt',
          'lockedPlayerCount',
          'cityScore',
          'cityLevel',
          'buildingLevels',
          'integrityTotal',
          'corruptionTotal',
          'timeoutTotal',
          'roleRotation',
          'updatedAt'
        ]);
      allow update: if isTeacher(roomId)
        && request.resource.data.teacherSessionId == resource.data.teacherSessionId;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && room(roomId).status == 'lobby'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.playerId == playerId
          && request.resource.data.classSection is string
          && request.resource.data.classSection.size() > 0
          && request.resource.data.classSection.size() <= 20
          && request.resource.data.studentNumber is int
          && request.resource.data.studentNumber > 0
          && request.resource.data.roleId == null
          && request.resource.data.roleHistory.size() == 0
          && request.resource.data.roleOffset == null;
        allow update: if (
          isTeacher(roomId)
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.nickname == resource.data.nickname
          && request.resource.data.nicknameKey == resource.data.nicknameKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'roleId',
            'roleHistory',
            'roleOffset'
          ])
          && request.resource.data.roleHistory.size() <= 8
          && request.resource.data.roleOffset >= 0
          && request.resource.data.roleOffset < 8
        ) || (
          isPlayerOwner(roomId, playerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        ) || (
          signedIn()
          && room(roomId).status != 'finished'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time
        );
        allow delete: if false;
      }

      match /questions/{questionId} {
        allow read: if signedIn();
        allow create: if isTeacher(roomId)
          && request.resource.data.questionId == questionId
          && request.resource.data.keys().hasOnly([
            'questionId',
            'roleId',
            'questionNumber',
            'prompt',
            'choices',
            'choiceOrder',
            'imageUrl'
          ]);
        allow update, delete: if false;
      }

      match /answers/{answerId} {
        allow get: if isTeacher(roomId)
          || (signedIn() && (
            !exists(/databases/$(database)/documents/rooms/$(roomId)/answers/$(answerId))
            || resource.data.ownerUid == request.auth.uid
          ));
        allow list: if isTeacher(roomId)
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.answerId == answerId
          && request.resource.data.roomId == roomId
          && request.resource.data.ownerUid == request.auth.uid
          && isPlayerOwnerAfter(roomId, request.resource.data.playerId)
          && request.resource.data.gameCycle == room(roomId).gameCycle
          && request.resource.data.submittedAt == request.time
          && request.time <= room(roomId).questionDeadlineAt
          && (
            (
              (
                !request.resource.data.keys().hasAny(['recordType'])
                || request.resource.data.recordType == 'question'
              )
              && request.resource.data.keys().hasOnly([
                'recordType',
                'answerId',
                'roomId',
                'playerId',
                'ownerUid',
                'gameCycle',
                'questionNumber',
                'questionId',
                'choiceId',
                'submittedAt'
              ])
              && answerId == string(request.resource.data.gameCycle) + '::' + request.resource.data.playerId + '::' + request.resource.data.questionId
              && room(roomId).status == 'playing'
              && request.resource.data.questionNumber == room(roomId).currentQuestionNumber
              && get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(request.resource.data.questionId)).data.questionId == request.resource.data.questionId
              && get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(request.resource.data.questionId)).data.questionNumber == room(roomId).currentQuestionNumber
              && get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(request.resource.data.questionId)).data.roleId == get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.resource.data.playerId)).data.roleId
              && (
                request.resource.data.choiceId
                  == get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(request.resource.data.questionId)).data.choices[0].id
                || request.resource.data.choiceId
                  == get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(request.resource.data.questionId)).data.choices[1].id
              )
            )
            ||
            (
              request.resource.data.recordType == 'crisis'
              && request.resource.data.keys().hasOnly([
                'recordType',
                'answerId',
                'roomId',
                'playerId',
                'ownerUid',
                'gameCycle',
                'eventIndex',
                'eventId',
                'roleId',
                'choiceId',
                'submittedAt'
              ])
              && room(roomId).status == 'crisis-playing'
              && request.resource.data.eventIndex == room(roomId).currentCrisisEventIndex
              && request.resource.data.eventId == room(roomId).currentCrisisEventId
              && request.resource.data.roleId == get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.resource.data.playerId)).data.roleId
              && answerId == string(request.resource.data.gameCycle) + '::' + request.resource.data.playerId + '::crisis::' + request.resource.data.eventId
              && request.resource.data.choiceId in [
                request.resource.data.eventId + ':' + request.resource.data.roleId + ':integrity',
                request.resource.data.eventId + ':' + request.resource.data.roleId + ':corruption'
              ]
            )
          );
        allow update, delete: if false;
      }

      match /rounds/{questionNumber} {
        allow read: if signedIn();
        allow create, update: if isTeacher(roomId);
        allow delete: if false;
      }

      match /crisisResults/{eventResultId} {
        allow read: if signedIn();
        allow create, update: if isTeacher(roomId);
        allow delete: if false;
      }

      match /personalResults/{decisionId} {
        allow read: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && isPlayerOwner(roomId, resource.data.playerId);
        allow create, update: if isTeacher(roomId)
          && request.resource.data.keys().hasOnly([
            'decisionId',
            'roomId',
            'playerId',
            'ownerUid',
            'gameCycle',
            'roleId',
            'source',
            'sequenceNumber',
            'outcome',
            'resolvedAt'
          ])
          && request.resource.data.decisionId == decisionId
          && request.resource.data.roomId == roomId
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.resource.data.playerId)).data.ownerUid
          && request.resource.data.gameCycle == room(roomId).gameCycle
          && request.resource.data.source in ['question', 'crisis']
          && request.resource.data.sequenceNumber is int
          && request.resource.data.sequenceNumber > 0
          && request.resource.data.outcome in ['integrity', 'corruption', 'timeout']
          && request.resource.data.resolvedAt == request.time
          && decisionId == string(request.resource.data.gameCycle) + '::' + request.resource.data.source + '::' + string(request.resource.data.sequenceNumber) + '::' + request.resource.data.playerId;
        allow delete: if false;
      }

      // Isolated from the realtime game engine on purpose: no dependency on
      // room.status (a PRE/POST/Reflection submission must succeed even if
      // the teacher has already advanced or finished the room while the
      // student was still answering), and no write ever allowed to modify
      // an existing record — every assessment record is create-once,
      // permanent, exactly like an answer.
      match /assessments/{assessmentId} {
        // The student's own realtime listener is established BEFORE they
        // submit, watching a document that does not exist yet. Without the
        // !exists(...) short-circuit, `resource` is null there and
        // `resource.data.ownerUid` throws during rule evaluation, which
        // Firestore treats as a permission denial — killing that listener
        // for good. The write itself still succeeds, but the listener that
        // was supposed to notice it never recovers, and the client staying
        // subscribed on that dead stream never routes the student onward
        // (only a full page reload re-subscribes and sees the truth). This
        // mirrors the same fix already applied to /answers.
        allow read: if isTeacher(roomId)
          || (signedIn() && assessmentId != 'observation' && (
            !exists(/databases/$(database)/documents/rooms/$(roomId)/assessments/$(assessmentId))
            || resource.data.ownerUid == request.auth.uid
          ));
        // Fields shared by every record type are checked once here; each
        // record type then adds its own id-prefix, shape, and content
        // checks in its own branch below. Covers Teacher Observation
        // (Phase B2a) and Student Assessments (PRE, POST, Reflection).
        allow create: if signedIn()
          && request.resource.data.schemaVersion == 1
          && request.resource.data.roomId == roomId
          && request.resource.data.submittedAt == request.time
          && (
            (
              // Teacher Observation (Phase B2a, room-level, teacher-owned)
              isTeacher(roomId)
              && assessmentId == 'observation'
              && request.resource.data.recordType == 'observation'
              && request.resource.data.teacherSessionId == request.auth.uid
              && isValidObservationScore(request.resource.data.o1)
              && isValidObservationScore(request.resource.data.o2)
              && isValidObservationScore(request.resource.data.o3)
              && isValidObservationScore(request.resource.data.o4)
              && isValidObservationNotes(request.resource.data.notes)
              && request.resource.data.keys().hasOnly([
                'schemaVersion',
                'recordType',
                'roomId',
                'teacherSessionId',
                'o1',
                'o2',
                'o3',
                'o4',
                'notes',
                'submittedAt'
              ])
            ) || (
              // Student Assessments (PRE, POST, Reflection)
              request.resource.data.ownerUid == request.auth.uid
              && isPlayerOwnerAfter(roomId, request.resource.data.playerId)
              && (
                (
                  request.resource.data.recordType == 'pre'
                  && assessmentId == 'pre::' + request.resource.data.playerId
                  && isValidPreResponses(request.resource.data.responses)
                  && request.resource.data.keys().hasOnly([
                    'schemaVersion',
                    'recordType',
                    'roomId',
                    'playerId',
                    'ownerUid',
                    'responses',
                    'submittedAt'
                  ])
                ) || (
                  request.resource.data.recordType == 'post'
                  && assessmentId == 'post::' + request.resource.data.playerId
                  && isValidPostResponses(request.resource.data.responses)
                  && request.resource.data.keys().hasOnly([
                    'schemaVersion',
                    'recordType',
                    'roomId',
                    'playerId',
                    'ownerUid',
                    'responses',
                    'submittedAt'
                  ])
                ) || (
                  request.resource.data.recordType == 'reflection'
                  && assessmentId == 'reflection::' + request.resource.data.playerId
                  && isMeaningfulReflectionText(request.resource.data.r1)
                  && isMeaningfulReflectionText(request.resource.data.r2)
                  && isMeaningfulReflectionText(request.resource.data.r3)
                  && request.resource.data.keys().hasOnly([
                    'schemaVersion',
                    'recordType',
                    'roomId',
                    'playerId',
                    'ownerUid',
                    'r1',
                    'r2',
                    'r3',
                    'submittedAt'
                  ])
                )
              )
            )
          );
        // Firestore evaluates a setDoc() over an existing document as an
        // update, not a create — so this alone is what makes every record
        // type immutable after creation; no separate "already exists"
        // check needed. Covers Observation, PRE, POST, and Reflection alike.
        allow update, delete: if false;
      }
    }
  }
}
