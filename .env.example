# Demo mode needs none of the Firebase variables below — it runs entirely
# in-memory/localStorage. Set to "false" to use real Firebase instead.
VITE_DEMO_MODE=false

# --- Firebase target -------------------------------------------------------
# VITE_FIREBASE_PROJECT_ID must be one of:
#   our-city-our-choice          (production — the real deployed app)
#   our-city-our-choice-staging  (staging — reserved id; project not created
#                                 yet, see README/report for manual Console
#                                 steps to create it)
# Any other value is refused at startup. Fill in the other VITE_FIREBASE_*
# values from whichever project's Firebase Console > Project settings page.
#
# This file is the base/production template — copy it to .env.local and
# fill in the production values for normal `npm run dev` / `npm run build`.
#
# For staging, ALSO copy it to .env.staging.local (gitignored, same as
# .env.local) with ALL SIX VITE_FIREBASE_* values below filled in from the
# staging project — every one, not just the project id. `npm run
# build:staging` runs scripts/validate-staging-env.mjs first, which reads
# .env.staging.local BY ITSELF (it never looks at .env.local) and fails the
# build immediately if any required value is missing/empty or if the
# project id isn't the staging one — so an incomplete .env.staging.local
# can never silently build with a mix of staging + production values.
# (Runtime also double-checks this at startup — see
# assertStagingBuildNotUsingProduction in src/domain/firebaseEnvironment.ts
# — but the pre-build check is what stops the build from ever starting.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=our-city-our-choice.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=our-city-our-choice
VITE_FIREBASE_STORAGE_BUCKET=our-city-our-choice.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=494504393166
VITE_FIREBASE_APP_ID=1:494504393166:web:97b036ae3b15fa9d5cd39f

# --- Emulator target (optional) --------------------------------------------
# Set to "true" to connect the app to a locally running
# `firebase emulators:start` instance (Firestore on 127.0.0.1:8080, Auth on
# 127.0.0.1:9099) instead of the real project above. Leave unset/"false" for
# staging or production. VITE_FIREBASE_PROJECT_ID must still be set to a
# valid id above even when using the emulator.
VITE_USE_FIREBASE_EMULATOR=false
