{
  "name": "our-city-our-choice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:staging": "node scripts/validate-staging-env.mjs && vite --mode staging --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:staging": "node scripts/validate-staging-env.mjs && tsc -b && vite build --mode staging",
    "deploy:staging": "node scripts/generate-staging-firestore-rules.mjs && npm run build:staging && firebase deploy --config firebase.staging.json --project staging --only firestore:rules,hosting",
    "layout:freeze-staging": "node scripts/freeze-staging-layout.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:staging": "node scripts/generate-staging-firestore-rules.mjs && firebase emulators:exec --only firestore --config firebase.staging.json \"vitest run --config vitest.staging-rules.config.ts\"",
    "loadtest:40": "node scripts/load-test-40.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@lottiefiles/dotlottie-react": "^0.19.13",
    "firebase": "^12.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.28.1",
    "globals": "^16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
